{
  "name": "quicklook-fast",
  "productName": "QuickLook Fast",
  "version": "0.1.2",
  "private": true,
  "license": "Apache-2.0",
  "author": "Chaoleme Studio",
  "description": "快速、离线的多格式文件预览",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "start": "electron .",
    "build": "npm run build:native && npm run typecheck && vite build && node scripts/patch-flyfish-pptx.cjs && node scripts/patch-flyfish-docx.cjs && tsc -p tsconfig.electron.json",
    "build:native": "node scripts/build-native.cjs",
    "electron:install": "install-electron --no",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.electron.json && node --test tests/*.test.cjs tests/*.test.mjs && node tests/run-native.cjs",
    "screenshots": "electron tools/screenshots/capture.cjs",
    "benchmark:file": "node tests/benchmark-file-service.cjs",
    "dist:win": "npm run electron:install && npm run build && node scripts/pack-portable.cjs"
  },
  "dependencies": {
    "@file-viewer/core": "3.3.4",
    "@file-viewer/renderer-binary": "3.3.4",
    "@file-viewer/renderer-design": "3.3.4",
    "@file-viewer/renderer-signature": "3.3.4",
    "@file-viewer/web-full": "3.3.4",
    "@zip.js/zip.js": "2.25.0",
    "dbus-next": "^0.10.2",
    "exifr": "7.1.3",
    "mime-types": "3.0.2",
    "node-unrar-js": "2.0.2",
    "officecrypto-tool": "0.0.19"
  },
  "devDependencies": {
    "@file-viewer/vite-plugin": "3.3.4",
    "@types/mime-types": "3.0.1",
    "@types/node": "24.10.1",
    "electron": "45.3.4",
    "happy-dom": "^21.0.4",
    "jszip": "3.10.2",
    "typescript": "5.9.3",
    "vite": "8.0.0"
  }
}
